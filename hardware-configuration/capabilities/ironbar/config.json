{
  "position": "top",
  "height": 32,
  "start": [
    { "type": "workspaces" },
    { "type": "focused", "show_icon": true, "show_title": true, "truncate": { "mode": "end", "max_length": 60 } }
  ],
  "center": [
    { "type": "clock", "format": "%a %d %b  %H:%M" }
  ],
  "end": [
    {
      "type": "custom",
      "name": "audio-pick",
      "bar": [
        { "type": "button", "name": "audio-out-name", "label": "🔊▾", "on_click": "!/run/current-system/sw/bin/audio-ctl pick sink" },
        { "type": "button", "name": "audio-mic-name", "label": "🎤▾", "on_click": "!/run/current-system/sw/bin/audio-ctl pick source" }
      ]
    },
    {
      "type": "volume",
      "format": "{icon} {percentage}%",
      "popup_orientation": "vertical",
      "sink_slider_orientation": "horizontal",
      "source_slider_orientation": "horizontal",
      "show_monitors": false,
      "max_volume": 100,
      "truncate": "end",
      "truncate_popup": "end",
      "icons": {
        "volume": "🔊",
        "muted": "🔇",
        "mic_volume": "🎤",
        "mic_muted": "🚫"
      },
      "profiles": {
        "medium": {
          "when": 66.66,
          "icons": {
            "volume": "🔉"
          }
        },
        "low": {
          "when": 33.33,
          "icons": {
            "volume": "🔈"
          }
        }
      }
    },
    {
      "type": "custom",
      "name": "spk-live",
      "show_if": "/run/current-system/sw/bin/audio-ctl live sink",
      "transition_type": "none",
      "bar": [
        { "type": "button", "class": "spk-live", "label": "🔊 ●", "on_click": "!/run/current-system/sw/bin/audio-ctl mute sink" }
      ]
    },
    {
      "type": "custom",
      "name": "spk-muted",
      "show_if": "/run/current-system/sw/bin/audio-ctl muted sink",
      "transition_type": "none",
      "bar": [
        { "type": "button", "class": "spk-muted", "label": "● 🔊", "on_click": "!/run/current-system/sw/bin/audio-ctl mute sink" }
      ]
    },
    {
      "type": "custom",
      "name": "mic-live",
      "show_if": "/run/current-system/sw/bin/audio-ctl live source",
      "transition_type": "none",
      "bar": [
        { "type": "button", "class": "mic-live", "label": "🎤 ●", "on_click": "!/run/current-system/sw/bin/audio-ctl mute source" }
      ]
    },
    {
      "type": "custom",
      "name": "mic-muted",
      "show_if": "/run/current-system/sw/bin/audio-ctl muted source",
      "transition_type": "none",
      "bar": [
        { "type": "button", "class": "mic-muted", "label": "● 🎤", "on_click": "!/run/current-system/sw/bin/audio-ctl mute source" }
      ]
    },
    {
      "type": "sys_info",
      "on_click_left": "/run/current-system/sw/bin/pkill -f '^/run/current-system/sw/bin/foot --app-id btop ' || /run/current-system/sw/bin/foot --app-id btop --title btop -e /run/current-system/sw/bin/btop",
      "interval": { "cpu": 5, "memory": 30, "temps": 10, "disks": 300, "networks": 30 },
      "format": [
        "🏋 {cpu_percent}%",
        "🧠 {memory_percent}%",
        "🌡️ {temp_c}°C"
      ]
    },
    {
      "type": "battery", 
      "format": "🔋 {percentage}%"
    },
    { "type": "tray", "format": "📤", "icon": "📤" }
  ]
}
